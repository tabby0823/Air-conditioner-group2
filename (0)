t = 27.0
hys = 1.2
ac_on = False

temp_list = [29.5, 28.6, 27.8, 26.3, 26.9, 28.1, 29.3]

for m in temp_list:
    if not ac_on:
        if m > t + hys:
           ac_on = True
           print(f"温度(m)℃，空调开启")
    else:
        if m < t - hys:
           ac_on = False
           print(f"温度(m)℃，空调关闭")

    print(f"当前温度(m)℃，空调状态：{'开启' if ac_on else '关闭'}")
